  "{category}value": {
    "measure_column": "{category}measure",
    "short_name": "Value",
    "long_name": "Value of the census measure identified by measure",
    "short_description": "Value for the measure identified by the `measure` column, taken unchanged from the census standard file. Units vary by measure; see the corresponding level.",
    "long_description": "Value for the measure identified by the `measure` column, taken unchanged from the census standard file (see each level's source documentation for definition and unit). Rows with missing values are dropped, so measures the Census Bureau could not estimate for small populations have fewer rows than the full geography x year grid. Rates and shares are proportions on a 0-1 scale, with these exceptions: `acs_OWS` is an unbounded S80/S20 ratio, `acs_DEP` is a dependency ratio, `acs_GNI` and `acs_REX` are 0-1 index values, `acs_AGE` is years, `acs_POP*`/`pep_population` are person counts, and `acs_INB`, `acs_INC`, `acs_PCI`, `acs_VAL` and `saipe_median_household_income` are nominal dollars, not inflation-adjusted. The five income-quintile shares (`acs_INL` through `acs_INP`) sum to 1 within a geography-year; `acs_INQ` is the top-5% share and is a subset of the highest quintile, not a sixth additive category.",
    "measure_type": "Mixed",
    "unit": "Varies by measure",
    "time_resolution": "Year",
    "categories": {
      "bundle_census/dist/census_county.parquet|": {},
      "bundle_census/dist/census_state.parquet|": {}
    }
  },
