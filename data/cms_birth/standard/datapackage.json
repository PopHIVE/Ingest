    "_sources": {
      "cms_birth": {
        "name": "Birthing Friendly Hospitals with Geocoded Addresses",
        "url": "https://data.cms.gov/provider-data/dataset/hbf-map",
        "organization": "Centers for Medicare & Medicaid Services (CMS)",
        "organization_url": "https://www.cms.gov/",
        "description": "A list, with geocoded addresses, of all Medicare-registered hospitals that meet CMS's criteria for the 'Birthing Friendly' designation, published on the CMS Provider Data Catalog. The designation identifies hospitals that participate in a statewide or national perinatal quality improvement collaborative and have implemented recommended patient safety practices for maternal health, drawn from CMS's Hospital Inpatient Quality Reporting (IQR) Program 'Maternal Morbidity Structural Measure.' This ingest aggregates the geocoded facility list to a count of designated hospitals per county, state, and nationally as of the most recent CMS update, assigning each hospital to a county via a point-in-polygon match of its latitude/longitude against Census county boundaries.",
        "restrictions": "Public domain. CMS data is generally not subject to copyright restrictions."
      },
      "id": "_sources"
    },
    "_catalog": {
      "summary": "CMS designates hospitals as Birthing Friendly when they follow best practices to improve maternal health and reduce harm during childbirth. This tracks how many hospitals hold that designation nationally and by state.",
