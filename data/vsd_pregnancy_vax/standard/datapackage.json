    "_sources": {
      "vsd": {
        "name": "Vaccine Safety Datalink (VSD) pregnancy vaccination coverage",
        "url": "https://www.cdc.gov/vaccine-safety-systems/vsd/index.html",
        "organization": "Centers for Disease Control and Prevention",
        "organization_url": "https://www.cdc.gov/ncird/",
        "location": "Percent of Pregnant Women Ages 18-49 Years Who Have Received an Influenza (or RSV) Vaccine, by Race and Ethnicity (FluVaxView and RSVVaxView dashboards)",
        "location_url": "https://data.cdc.gov/d/8fbp-accd",
        "description": "The Vaccine Safety Datalink (VSD) is a collaboration between CDC's Immunization Safety Office and integrated health care organizations that uses electronic health records to monitor vaccine safety. CDC uses the VSD to publish weekly cumulative flu vaccination coverage among pregnant women ages 18-49 from the 2019-20 season, and RSV vaccination coverage among pregnant women who reach 32 weeks' gestation, overall and by race and ethnicity. The current data come from 10 reporting sites. Estimates are national only, describe VSD members rather than all pregnant women, can change as pregnancies are identified, and may miss vaccines given outside the health system.",
