      "cms_medicare": {
        "name": "Medicare Fee-For-Service claims (CMS Chronic Conditions Warehouse)",
        "url": "https://www2.ccwdata.org/web/guest/home",
        "organization": "Centers for Medicare & Medicaid Services, analysed by the Centers for Disease Control and Prevention",
        "organization_url": "https://www.cdc.gov/ncird/",
        "location": "Weekly Cumulative Influenza (and RSV) Vaccination Coverage, by Race and Ethnicity, Medicare Fee-For-Service Beneficiaries (FluVaxView and RSVVaxView dashboards)",
        "location_url": "https://data.cdc.gov/d/agz7-4mvg",
        "description": "CDC estimates vaccination coverage among Medicare fee-for-service beneficiaries from administrative claims in the CMS Chronic Conditions Warehouse. Weekly cumulative estimates are calculated with Kaplan-Meier survival analysis among beneficiaries enrolled as of August 1. They cover flu vaccines received since August 1 of each season among adults 65 and older, from the 2019-20 season, and RSV vaccines received since August 1, 2023 among adults 75 and older enrolled in a Part D plan. Estimates are national, by race and ethnicity, and reflect claims processed by the CMS data release date. Medicare Advantage enrollees are not included.",
