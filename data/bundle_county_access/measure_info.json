  "{category}value": {
    "measure_column": "{category}outcome_name",
    "short_name": "Value",
    "long_name": "Value of the determinant measure identified by outcome_name",
    "short_description": "Value for the measure identified by the `outcome_name` column. Units differ by measure: HUD, BLS, USDA and every Census rate or share are proportions (0-1); AHRF measures are counts, rates, codes, or percentages; the remaining Census measures are dollars, ratios or index values as documented for each source variable.",
    "long_description": "Value for the measure identified by the `outcome_name` column, taken unchanged from the contributing source's standard file (see each level's source documentation for definition and unit). Rows with missing values are dropped, so sparse AHRF measures have fewer rows than the full county x year grid. Note that `ahrf_rural_urban_code` is a categorical USDA Rural-Urban Continuum Code (1-9) stored numerically. Every Census rate and share in this file is a proportion on the same 0-1 scale as the HUD, BLS and USDA measures, so they are directly comparable; this includes the income-quintile shares (`acs_INL`, `acs_INM`, `acs_INN`, `acs_INO`, `acs_INP`), which sum to 1 within a geography-year, while `acs_INQ` is the top-5% share and is a subset of the highest quintile rather than a sixth additive category. Three Census groups are not proportions: `acs_OWS` is an unbounded S80/S20 ratio, `acs_GNI` is a 0-1 Gini index, and `acs_INB`, `acs_INC`, `acs_PCI` and `saipe_median_household_income` are nominal dollars, not inflation-adjusted, so they are not comparable across vintages without deflating.",
    "measure_type": "Mixed",
    "unit": "Varies by measure",
    "time_resolution": "Year",
    "categories": {
      "bundle_county_access/dist/county_determinants.parquet|": {},
      "bundle_county_access/dist/state_determinants.parquet|": {}
    }
  },

