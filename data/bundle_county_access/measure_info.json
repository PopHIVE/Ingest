  "_sources": {
    "chr": {
      "name": "County Health Rankings & Roadmaps",
      "url": "https://www.countyhealthrankings.org",
      "organization": "University of Wisconsin Population Health Institute",
      "organization_url": "https://uwphi.pophealth.wisc.edu",
      "location": "County Health Rankings & Roadmaps Annual Data",
      "location_url": "https://www.countyhealthrankings.org/health-data/methodology-and-sources/data-documentation",
      "description": "The County Health Rankings & Roadmaps (CHR&R) program, a collaboration between the Robert Wood Johnson Foundation and the University of Wisconsin Population Health Institute, ranks the health of nearly all counties in the nation. The annual rankings measure vital health factors including high school graduation rates, obesity, smoking, unemployment, access to healthy foods, the quality of air and water, income inequality, and teen births that influence how long and how well we live. Data are released annually and cover all U.S. counties. Raw data are publicly available through the Zenodo repository (https://doi.org/10.5281/zenodo.18157681) and span release years 2010 through the present.",
      "restrictions": "CC BY 4.0. Attribution required. Cite as: University of Wisconsin Population Health Institute. County Health Rankings & Roadmaps. https://www.countyhealthrankings.org.",
      "date_accessed": 2025
    }
  }
